DATABASE_URL="postgresql://wce:wce_dev_password@localhost:5433/wce_association?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used to build tenant links & webhook callback URLs)
APP_BASE_URL="http://localhost:3000"
# Root domain: tenants are served at {slug}.APP_BASE_DOMAIN (e.g. boulangers-afrique.localhost)
APP_BASE_DOMAIN="localhost"
# Optional: this server's public IPv4 address, used to auto-verify tenant custom
# domains that use an A record (apex/root domains). Leave empty to only auto-verify
# CNAME-based custom domains (recommended: subdomains like www.example.org).
APP_SERVER_IP=""

# SasPay (mobile money aggregator) — fill in once real merchant credentials are issued.
# Until then PAYMENT_PROVIDER=mock lets the whole subscription flow run end-to-end.
PAYMENT_PROVIDER="mock" # "mock" | "saspay"
SASPAY_BASE_URL="https://api.saspay.example/v1"
SASPAY_API_KEY=""
SASPAY_API_SECRET=""
SASPAY_WEBHOOK_SECRET=""

# Local media storage
UPLOAD_DIR="./public/uploads"
